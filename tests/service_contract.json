{
  "repo": "HappyHorseGemini",
  "display": "HappyHorse",
  "id": "happyhorse-by-ace-data-cloud",
  "prefix": "happyhorse",
  "skill": "happyhorse-video",
  "secret": "ACEDATACLOUD_HAPPYHORSE_TOKEN",
  "endpoint": "https://happyhorse.mcp.acedata.cloud/mcp",
  "server_repo": "HappyHorseMCP",
  "tools": [
    "happyhorse_list_models",
    "happyhorse_generate_video",
    "happyhorse_generate_video_from_image",
    "happyhorse_generate_video_from_references",
    "happyhorse_edit_video",
    "happyhorse_get_task",
    "happyhorse_get_tasks_batch"
  ],
  "reference": "happyhorse_list_models",
  "marker": "Happy",
  "task_tool": "happyhorse_get_task",
  "task_arg": "task_id",
  "media": "video",
  "apis": [
    "/happyhorse/videos",
    "/happyhorse/tasks"
  ],
  "workflow": "Choose text-to-video, image-to-video, reference-image video, or video edit explicitly. Image-to-video requires image_url; references require image_urls as an actual array; video editing requires video_url plus prompt. Read supported model/resolution/ratio/duration from the current tool schema; do not map Seedance fields into this service.",
  "key_label": "Ace Data Cloud HappyHorse API Token",
  "schemas": [
    {
      "name": "happyhorse_list_models",
      "description": "List Happy Horse actions, compatible models, and defaults.",
      "inputSchema": {
        "properties": {},
        "title": "happyhorse_list_modelsArguments",
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "title": "happyhorse_list_modelsOutput",
        "type": "object"
      }
    },
    {
      "name": "happyhorse_get_task",
      "description": "Get the status and final video URL for one Happy Horse task.",
      "inputSchema": {
        "properties": {
          "task_id": {
            "description": "Task ID returned by a Happy Horse generation or edit tool.",
            "title": "Task Id",
            "type": "string"
          }
        },
        "required": [
          "task_id"
        ],
        "title": "happyhorse_get_taskArguments",
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "title": "happyhorse_get_taskOutput",
        "type": "object"
      }
    },
    {
      "name": "happyhorse_get_tasks_batch",
      "description": "Get multiple Happy Horse tasks in one request.",
      "inputSchema": {
        "properties": {
          "task_ids": {
            "description": "One to fifty Happy Horse task IDs.",
            "items": {
              "type": "string"
            },
            "maxItems": 50,
            "minItems": 1,
            "title": "Task Ids",
            "type": "array"
          }
        },
        "required": [
          "task_ids"
        ],
        "title": "happyhorse_get_tasks_batchArguments",
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "title": "happyhorse_get_tasks_batchOutput",
        "type": "object"
      }
    },
    {
      "name": "happyhorse_generate_video",
      "description": "Generate a video from a text prompt with Happy Horse.",
      "inputSchema": {
        "properties": {
          "prompt": {
            "description": "Detailed text-to-video prompt describing subject, motion, camera, lighting, style, and mood.",
            "minLength": 1,
            "title": "Prompt",
            "type": "string"
          },
          "model": {
            "default": "happyhorse-1.1-t2v",
            "description": "Text-to-video model: happyhorse-1.0-t2v or happyhorse-1.1-t2v.",
            "enum": [
              "happyhorse-1.0-t2v",
              "happyhorse-1.1-t2v"
            ],
            "title": "Model",
            "type": "string"
          },
          "resolution": {
            "default": "1080P",
            "description": "Output resolution: 720P or 1080P.",
            "enum": [
              "720P",
              "1080P"
            ],
            "title": "Resolution",
            "type": "string"
          },
          "ratio": {
            "default": "16:9",
            "description": "Output aspect ratio: 16:9, 9:16, 1:1, 4:3, or 3:4.",
            "enum": [
              "16:9",
              "9:16",
              "1:1",
              "4:3",
              "3:4"
            ],
            "title": "Ratio",
            "type": "string"
          },
          "duration": {
            "default": 5,
            "description": "Output duration in seconds, from 3 through 15.",
            "maximum": 15,
            "minimum": 3,
            "title": "Duration",
            "type": "integer"
          },
          "watermark": {
            "default": false,
            "description": "Whether to add a Happy Horse watermark.",
            "title": "Watermark",
            "type": "boolean"
          },
          "seed": {
            "anyOf": [
              {
                "maximum": 2147483647,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional reproducibility seed.",
            "title": "Seed"
          },
          "callback_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional webhook URL. Omit it to receive a task ID for polling.",
            "title": "Callback Url"
          }
        },
        "required": [
          "prompt"
        ],
        "title": "happyhorse_generate_videoArguments",
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "title": "happyhorse_generate_videoOutput",
        "type": "object"
      }
    },
